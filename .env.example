# Same Clerk application as the backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Backend origin. The Next.js /api/* proxy forwards here with the Clerk session JWT.
API_URL="http://localhost:4000"

# Optional public Trigger.dev base (usually unnecessary — run tokens are minted per send).
NEXT_PUBLIC_TRIGGER_API_URL=
